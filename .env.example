# Firebase web app config — Project settings → General → Your apps → SDK setup.
# Copy this file to `.env` and fill in the values, then restart `npm run dev`.
#
# These are not secrets: Firebase web config ships in the client bundle by
# design. Access is controlled by firestore.rules, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at `firebase emulators:start` instead of the real
# project, so local development costs nothing against the daily Spark quota.
# The six values above still need to be non-empty, but can be dummy strings.
# VITE_USE_EMULATOR=true
